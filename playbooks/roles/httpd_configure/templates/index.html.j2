<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ httpd_configure_server_name }}</title>
  <style>
    body { font-family: ui-monospace, monospace; margin: 0; min-height: 100vh;
           display: grid; place-items: center; background: #f8fafc; }
    .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
            padding: 2.5rem 3rem; text-align: center; box-shadow: 0 1px 2px #0001; }
    .ok { color: #16a34a; font-weight: 600; }
    h1 { margin: 0 0 .5rem; font-size: 1.3rem; }
    p  { margin: 0; color: #64748b; }
  </style>
</head>
<body>
  <div class="card">
    <h1><span class="ok">&middot;</span> {{ httpd_configure_server_name }}</h1>
    <p>Managed by Ansible Automation Platform &mdash; configuration deployed successfully.</p>
  </div>
</body>
</html>
